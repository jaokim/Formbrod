; ---- Menus ----------------------------------------------------------------
; Menu shortcuts (Amiga-O, Amiga-Q, ...) are fixed in the program and follow
; the Amiga style guide, so they are not part of these strings.
MSG_MENU_PROJECT (100//)
Project
;
MSG_MENU_ADD (101//)
Add file...
;
MSG_MENU_PREVIEW (102//)
Preview
;
MSG_MENU_EXPORT (103//)
Export...
;
MSG_MENU_CANCEL (104//)
Cancel render
;
MSG_MENU_ABOUT (105//)
About...
;
MSG_MENU_QUIT (106//)
Quit
;
MSG_MENU_EDIT (107//)
Edit
;
MSG_MENU_SPLIT (108//)
Split at playhead
;
MSG_MENU_REMOVE (109//)
Remove clip
;
; Lists the effect modules; picking one adds it to the selected clip.
MSG_MENU_EFFECTS (110//)
Effects
;
MSG_MENU_SETTINGS (111//)
Settings
;
