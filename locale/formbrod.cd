; ---- The preview window ---------------------------------------------------
;
; Title of the window the edit plays in.
MSG_PLAYWIN_TITLE (242//)
Preview
;
; %s is a time in the edit, where playing starts (the playhead).
MSG_STATUS_PLAYING (243//)
Playing from %s
;
; %s is the time in the edit where it was stopped.
MSG_STATUS_PLAY_STOPPED (244//)
Stopped at %s
;
MSG_STATUS_PLAY_END (245//)
Played to the end
